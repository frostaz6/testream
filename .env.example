# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma-separated Plex usernames and/or account email addresses
PLEX_ALLOWLIST=your-plex-username,person@example.com
# Set only if a trusted Stremio add-on or HTTP media endpoint is on your LAN:
STREAM_HOST_ALLOWLIST=
# Optional; use only with a correctly configured HTTPS reverse proxy
TRUST_PROXY=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Stremio authentication by default. Jellyfin login is entirely optional.
AUTH_MODE=stremio
STREMIO_ALLOWLIST=
JELLYFIN_URL=
JELLYFIN_ALLOWLIST=

# Optional FastChannels Docker profile: never publicly bound by default.
FASTCHANNELS_BIND_IP=127.0.0.1
# When connecting a TV/capture device, set a LAN-reachable URL instead.
FASTCHANNELS_PUBLIC_BASE_URL=http://127.0.0.1:5523

# Copy real feed and XMLTV URLs from FastChannels > Feeds.
# Clear/default example: http://fastchannels:5523/feeds/default/m3u
FASTCHANNELS_M3U_URL=
FASTCHANNELS_EPG_URL=
# For protected channels, use the separate Bridge outputs from FastChannels > Feeds.
FASTCHANNELS_BRIDGE_M3U_URL=
FASTCHANNELS_BRIDGE_EPG_URL=
# One tuner for one physical HDMI capture unit; change only when supported.
FASTCHANNELS_BRIDGE_TUNERS=1
# Exact trusted local host(s) used by M3U/EPG URLs and media endpoints.
STREAM_HOST_ALLOWLIST=

# Keep off until choosing HTTPS + a trusted proxy deployment.
TRUST_PROXY=false

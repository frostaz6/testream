# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Default: Stremio login only, with optional Stremio email allowlist.
AUTH_MODE=stremio
STREMIO_ALLOWLIST=
# Optional second authentication step: AUTH_MODE=jellyfin
# Jellyfin is NOT required for the player. Enter a trusted server URL reachable by the Docker container.
JELLYFIN_URL=
# Required only when AUTH_MODE=jellyfin; comma-separated usernames or user IDs.
JELLYFIN_ALLOWLIST=
# Set only if a trusted Stremio add-on or HTTP media endpoint is on your LAN:
STREAM_HOST_ALLOWLIST=
# Optional; use only with a correctly configured HTTPS reverse proxy
TRUST_PROXY=false
